<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- 1) Snippet principale -->
  <template id="template_booking_form" name="Booking Form">
    <section class="s_snippet booking_form_snippet" data-snippet="internal">
      <div class="container my-5">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-12">
            <form action="/hotel/booking/submit" method="post" target="_blank">
              <!-- CSRF token -->
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

              <div class="row align-items-start justify-content-center">
                <!-- Check-In -->
                <div class="col-6 col-md-3">
                  <div class="mb-3">
                    <label for="check_in" class="form-label">Check-in</label>
                    <input type="date"
                           id="check_in"
                           name="check_in"
                           class="form-control form-control-lg"
                           style="font-size:1.15rem; height: calc(1.4em + 1.2rem + 0.70rem); border-radius: 0; width: 100%;"
                           required="required"/>
                  </div>
                </div>
                <!-- Check-Out -->
                <div class="col-6 col-md-3">
                  <div class="mb-3">
                    <label for="check_out" class="form-label">Check-out</label>
                    <input type="date"
                           id="check_out"
                           name="check_out"
                           class="form-control form-control-lg"
                           style="font-size:1.15rem; height: calc(1.4em + 1.2rem + 0.70rem); border-radius: 0; width: 100%;"
                           required="required"/>
                  </div>
                </div>
                <!-- Ospiti -->
                <div class="col-6 col-md-3">
                  <div class="mb-3">
                    <label for="guests" class="form-label">Ospiti</label>
                    <select id="guests" name="guests"
                            class="form-control form-control-lg"
                            required="required"
                            style="font-size:1.25rem; height: calc(1.4em + 1.2rem + 0.70rem); border-radius: 0; width: 100%;">
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>
                  </div>
                </div>
                <!-- Bambini -->
                <div class="col-6 col-md-3">
                  <div class="mb-3">
                    <label for="children" class="form-label">Bambini</label>
                    <select id="children" name="children"
                            class="form-control form-control-lg"
                            required="required"
                            style="font-size:1.25rem; height: calc(1.4em + 1.2rem + 0.70rem); border-radius: 0; width: 100%;">
                      <option value="0">0</option>
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="row justify-content-center mt-4">
                <div class="col-auto">
                  <button type="submit" class="btn btn-primary btn-lg"
                          style="font-size:1rem; padding: 0.5rem 1rem; border-radius: 0;">
                    CERCA STANZA
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </template>

  <!-- 2) Snippet statico per il builder -->
  <template id="snippet_booking_form_static"
            name="Booking Form Snippet Static (Contenuto Interno)"
            inherit_id="website.snippets">
    <xpath expr="//snippets[@id='snippet_content']/*[1]" position="before">
      <t t-snippet="website_select_check_in.template_booking_form"
         string="Check-in/out"
         t-thumbnail="/website_select_check_in/static/src/img/date.jpeg"/>
    </xpath>
  </template>

  <!-- 3) Opzioni drag’n’drop -->
  <template id="snippet_options" inherit_id="website.snippet_options">
    <xpath expr="." position="inside">
      <div data-selector=".s_snippet"
           data-drop-in=".oe_structure, [class^=col-]"
           data-drop-near="p, h1, h2, h3, blockquote"/>
    </xpath>
  </template>
</odoo>
